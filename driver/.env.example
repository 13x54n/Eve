# Local Metro / Expo start. Store builds use eas.json env, not this file.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_native_app_client_id

# Auth0 Allowed Callback URLs and Allowed Logout URLs (lowercase, no trailing slash):
# evedriver://YOUR_DOMAIN/ios/ca.sherpafoods.evedriver/callback
# evedriver://YOUR_DOMAIN/android/ca.sherpafoods.evedriver/callback

# Optional. Defaults to EXPO_PUBLIC_API_URL with /api stripped.
# EXPO_PUBLIC_WS_URL=http://localhost:4000
