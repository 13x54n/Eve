# Local Metro / Expo start. Store builds use eas.json env, not this file.
EXPO_PUBLIC_AUTH_URL=http://localhost:4001/api
EXPO_PUBLIC_API_URL=http://localhost:4003/api
EXPO_PUBLIC_WS_URL=http://localhost:4004
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-driver-privy-client-id
EXPO_PUBLIC_PRIVY_RELYING_PARTY=https://your-domain.com

# Use a driver-specific Privy App Client. Enable SMS, email, identity tokens,
# and Ethereum + Solana embedded wallets in the Privy Dashboard.
#
# iOS Simulator: localhost URLs above work.
# Android Emulator: adb reverse tcp:4001/4003/4004 or use 10.0.2.2 instead of localhost.
# Physical device: use your LAN IP.
