# Local Metro / Expo Go-style start. Store builds use eas.json env, not this file.
EXPO_PUBLIC_AUTH_URL=http://localhost:4001/api
EXPO_PUBLIC_API_URL=http://localhost:4003/api
EXPO_PUBLIC_WS_URL=http://localhost:4004
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_native_app_client_id

# EXPO_PUBLIC_AUTH0_DOMAIN must be host only (no https://). Same Native Client ID as driver.
# Allowed Callback URLs (login):
# eve://YOUR_DOMAIN/ios/ca.sherpafoods.eve/callback
# eve://YOUR_DOMAIN/android/ca.sherpafoods.eve/callback
# evedriver://YOUR_DOMAIN/ios/ca.sherpafoods.evedriver/callback
# evedriver://YOUR_DOMAIN/android/ca.sherpafoods.evedriver/callback
# Allowed Logout URLs (must be /logout, not /callback):
# eve://YOUR_DOMAIN/ios/ca.sherpafoods.eve/logout
# eve://YOUR_DOMAIN/android/ca.sherpafoods.eve/logout
# evedriver://YOUR_DOMAIN/ios/ca.sherpafoods.evedriver/logout
# evedriver://YOUR_DOMAIN/android/ca.sherpafoods.evedriver/logout
# If you see "callback URL mismatch", copy redirect_uri from the error page exactly.
