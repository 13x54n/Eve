FROM node:22-bookworm-slim

RUN apt-get update -y && \
    apt-get install -y openssl python3 make g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/http/package.json ./packages/http/
COPY packages/grpc/package.json ./packages/grpc/
COPY services/auth/package.json ./services/auth/
COPY services/location/package.json ./services/location/
COPY services/ride/package.json ./services/ride/
COPY services/notify/package.json ./services/notify/
COPY services/admin/package.json ./services/admin/

RUN npm ci

COPY . .

# Supplied at build time from backend/.env (see docker-compose.yml build.args).
ARG DATABASE_URL
ENV DATABASE_URL="postgresql://eve:eve@postgres:5432/eve"
RUN npx prisma generate

CMD ["npm", "run", "dev"]
