# ============================================
# Eve Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Keep localhost URLs below for npm run dev on the host.
# docker compose up overrides DATABASE_URL, REDIS_URL, and gRPC hosts
# to Docker DNS names (postgres, redis, location, notify).

# ============================================
# Node Environment
# ============================================
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://eve:eve@localhost:5432/eve

# ============================================
# Redis Configuration
# ============================================
# Redis connection URL
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Secrets (REQUIRED)
# ============================================
# IMPORTANT: Generate strong random secrets for production
# Example: openssl rand -base64 32

# REQUIRED - Access token secret
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production

# Refresh token secret (if using refresh tokens)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# Password reset secret
PASSWORD_RESET_SECRET=your-password-reset-secret-change-in-production

# ============================================
# Internal Service Authentication (REQUIRED)
# ============================================
# REQUIRED for production when services communicate over network
# Generate with: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=replace-with-internal-service-secret

# ============================================
# Privy Configuration (REQUIRED for mobile apps)
# ============================================
# REQUIRED - Privy application ID from the dashboard
PRIVY_APP_ID=your-privy-app-id

# REQUIRED - Privy application secret (server only; never put this in mobile apps)
PRIVY_APP_SECRET=your-privy-app-secret

# ============================================
# Service Ports
# ============================================
AUTH_PORT=4001
LOCATION_PORT=4002
RIDE_PORT=4003
NOTIFY_PORT=4004
ADMIN_PORT=4005

# ============================================
# Driver Eve Wallet payouts (OPTIONAL)
# ============================================
# Platform treasury sends testnet crypto to the driver's Privy Ethereum
# address when they cash out walletBalance. If these are unset, cash-outs
# stay PENDING for an admin. Trip fares remain cash / off-platform.
#
# Default chain: Base Sepolia (84532). PAYOUT_USD_PER_TOKEN=1 means $1 ledger
# equals 1 token unit (testnet). Native ETH is used unless PAYOUT_TOKEN_ADDRESS
# is set (ERC-20, default 6 decimals).
TREASURY_PRIVATE_KEY=
CHAIN_RPC_URL=
PAYOUT_CHAIN_ID=84532
PAYOUT_CHAIN_NAME=Base Sepolia
PAYOUT_EXPLORER_TX_URL=https://sepolia.basescan.org/tx/
PAYOUT_TOKEN_ADDRESS=
PAYOUT_TOKEN_SYMBOL=ETH
PAYOUT_TOKEN_DECIMALS=18
PAYOUT_USD_PER_TOKEN=1

# ============================================
# Location Service Configuration
# ============================================
# Match radius is a code constant (15 km), not this file.
# MATCH_RADIUS_KM is unused by the location service.

# ============================================
# gRPC Configuration (REQUIRED for inter-service communication)
# ============================================
# gRPC is always enabled for inter-service communication

# REQUIRED - gRPC service ports
LOCATION_GRPC_PORT=50051
NOTIFY_GRPC_PORT=50052

# REQUIRED - gRPC service URLs (for client connections)
LOCATION_GRPC_URL=127.0.0.1:50051
NOTIFY_GRPC_URL=127.0.0.1:50052

# For Docker: Use service names as hosts
# LOCATION_GRPC_URL=location:50051
# NOTIFY_GRPC_URL=notify:50052

# Enable gRPC request/response logging (OPTIONAL)
GRPC_LOGGING=false

# ============================================
# ImageKit Configuration (OPTIONAL - for driver photos)
# ============================================
# Get these from https://imagekit.io/dashboard
# Leave empty if not using driver photo uploads
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
IMAGEKIT_DRIVER_FOLDER=/eve/drivers

# ============================================
# Email Configuration (OPTIONAL - for password reset, notifications)
# ============================================
# OPTIONAL - SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourapp.com

# ============================================
# Logging and Monitoring (OPTIONAL)
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# CORS Configuration (OPTIONAL)
# ============================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Rate Limiting (OPTIONAL)
# ============================================
# Max requests per window
RATE_LIMIT_MAX=100
# Window in minutes
RATE_LIMIT_WINDOW=15

# ============================================
# Testing (for Vitest)
# ============================================
VITEST=false
