# Database
DATABASE_URL=postgresql://eve:eve@localhost:5432/eve

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-generated-with-openssl-rand

# Internal Service Authentication (REQUIRED for production)
# Generate with: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=replace-with-internal-service-secret

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_native_app_client_id

# Optional: ImageKit (for driver document uploads)
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# IMAGEKIT_DRIVER_FOLDER=drivers

# Optional: CORS Origins (comma-separated, defaults shown)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Optional: Gateway Configuration
# PORT=4000
# GATEWAY_MODE=compose

# Optional: Service URLs (for proxy mode)
# AUTH_URL=http://localhost:4001
# LOCATION_URL=http://localhost:4002
# RIDE_URL=http://localhost:4003
# NOTIFY_URL=http://localhost:4004

# Optional: Service Ports (for split process mode)
# AUTH_PORT=4001
# LOCATION_PORT=4002
# RIDE_PORT=4003
# NOTIFY_PORT=4004

# Optional: Redis (for location/matching service)
# REDIS_URL=redis://localhost:6379

# Node Environment
# NODE_ENV=development
