generator client {
  provider = "prisma-client"
  output   = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum AdminStaffRole {
  OWNER
  OPERATIONS
  FINANCE
  SUPPORT
  SAFETY
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING
  DEACTIVATED
}

enum DriverApprovalStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum DriverPresence {
  OFFLINE
  ONLINE
  IDLE
  ON_TRIP
}

enum DocumentType {
  IDENTITY
  LICENSE
  INSURANCE
  BACKGROUND_CHECK
  VEHICLE_REGISTRATION
  VEHICLE_INSPECTION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VehicleType {
  BIKE
  CAR
}

enum TripStatus {
  SCHEDULED
  SEARCHING
  ASSIGNED
  ONGOING
  COMPLETED
  CANCELLED
  NO_DRIVER
  DRIVER_NO_SHOW
  RIDER_NO_SHOW
  TECHNICAL_FAILURE
}

enum TripOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum RideType {
  STANDARD
  AIRPORT
  MULTI_STOP
  SCHEDULED
  CORPORATE
}

enum PaymentMethodKind {
  CARD
  WALLET
  CASH
  CORPORATE
  PROMO
}

enum LedgerType {
  CHARGE
  REFUND
  PAYOUT
  WALLET_TOPUP
  WALLET_WITHDRAW
  CREDIT
  ADJUSTMENT
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
  DISPUTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentType {
  SOS
  ACCIDENT
  ASSAULT
  HARASSMENT
  UNSAFE_DRIVING
  LOST_ITEM
  MEDICAL
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PricingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ROLLED_BACK
}

enum ZoneKind {
  SERVICE
  AIRPORT
  NO_SERVICE
  RESTRICTED
}

enum AlertKind {
  SOS
  PAYMENT_FAILURE
  UNUSUAL_CANCELLATION
  SYSTEM
  DOCUMENT_EXPIRY
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?         @unique
  passwordHash   String
  role           UserRole        @default(RIDER)
  adminStaffRole AdminStaffRole?
  accountStatus  AccountStatus   @default(ACTIVE)
  isActive       Boolean         @default(true)
  flagged        Boolean         @default(false)
  city           String?
  mfaEnabled     Boolean         @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  resetCodes        PasswordResetCode[]
  riderProfile      RiderProfile?
  driverProfile     DriverProfile?
  loginEvents       AdminLoginEvent[]
  sessions          AdminSession[]
  auditLogs         AuditLog[]          @relation("AuditActor")
  assignedTickets   SupportTicket[]     @relation("TicketAssignee")
  assignedIncidents SafetyIncident[]    @relation("IncidentAssignee")
  notifications     Notification[]
  tripMessages      TripMessage[]
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RiderProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus  ReviewStatus @default(PENDING)
  rating              Decimal      @default(5.00) @db.Decimal(3, 2)
  walletBalance       Decimal      @default(0) @db.Decimal(12, 2)
  loyaltyPoints       Int          @default(0)
  consentMarketing    Boolean      @default(false)
  deletionRequestedAt DateTime?
  notes               String?
  trips               Trip[]             @relation("RiderTrips")
  paymentMethods      PaymentMethod[]
  tickets             SupportTicket[]
  incidents           SafetyIncident[]   @relation("RiderIncidents")
  lostItems           LostItem[]
  privacyRequests     PrivacyRequest[]
}

model FleetCompany {
  id       String          @id @default(cuid())
  name     String
  city     String?
  drivers  DriverProfile[]
  vehicles Vehicle[]
}

model DriverProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleetCompanyId   String?
  fleetCompany     FleetCompany?         @relation(fields: [fleetCompanyId], references: [id])
  approvalStatus   DriverApprovalStatus  @default(PENDING)
  presence         DriverPresence        @default(OFFLINE)
  rating           Decimal               @default(5.00) @db.Decimal(3, 2)
  acceptanceRate   Decimal               @default(0) @db.Decimal(5, 2)
  cancellationRate Decimal               @default(0) @db.Decimal(5, 2)
  onlineHours      Decimal               @default(0) @db.Decimal(10, 2)
  earningsTotal    Decimal               @default(0) @db.Decimal(12, 2)
  city             String?
  latitude         Float?
  longitude        Float?
  notes            String?
  documents        DriverDocument[]
  vehicles         Vehicle[]
  trips            Trip[]                @relation("DriverTrips")
  incidents        SafetyIncident[]      @relation("DriverIncidents")
  incentives       DriverIncentive[]
  offers           TripOffer[]
}

model Vehicle {
  id               String         @id @default(cuid())
  driverId         String?
  driver           DriverProfile? @relation(fields: [driverId], references: [id])
  fleetCompanyId   String?
  fleetCompany     FleetCompany?  @relation(fields: [fleetCompanyId], references: [id])
  make             String
  model            String
  year             Int
  plateNumber      String         @unique
  color            String
  vehicleType      VehicleType    @default(CAR)
  serviceCategory  String
  capacity         Int
  inspectionStatus ReviewStatus   @default(PENDING)
  city             String?
  trips            Trip[]
}

model DriverDocument {
  id           String       @id @default(cuid())
  driverId     String
  driver       DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type         DocumentType
  status       ReviewStatus @default(PENDING)
  expiresAt    DateTime?
  notes        String?
  imageKitFileId String?
  fileUrl      String?
  fileName     String?
  mimeType     String?
  fileSize     Int?
  reviewedAt   DateTime?
  reviewedById String?
}

model Trip {
  id                 String            @id @default(cuid())
  bookingCode        String            @unique
  riderId            String
  rider              RiderProfile      @relation("RiderTrips", fields: [riderId], references: [id])
  driverId           String?
  driver             DriverProfile?    @relation("DriverTrips", fields: [driverId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?          @relation(fields: [vehicleId], references: [id])
  status             TripStatus
  rideType           RideType          @default(STANDARD)
  vehicleType        VehicleType       @default(CAR)
  city               String
  zone               String?
  pickupAddress      String
  dropoffAddress     String
  pickupLat          Float
  pickupLng          Float
  dropoffLat         Float
  dropoffLng         Float
  distanceKm         Decimal           @db.Decimal(8, 2)
  durationMin        Int
  suggestedFare      Decimal           @db.Decimal(12, 2)
  fareTotal          Decimal           @db.Decimal(12, 2)
  paymentStatus      LedgerStatus      @default(PENDING)
  paymentMethod      PaymentMethodKind
  cancellationReason String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  etaMinutes         Int?
  routeDeviation     Boolean           @default(false)
  events             TripEvent[]
  ledger             LedgerEntry[]
  tickets            SupportTicket[]
  incidents          SafetyIncident[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  offers             TripOffer[]
  chatMessages       TripMessage[]

  @@index([status, city, createdAt])
  @@index([bookingCode])
}

model TripMessage {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}

model TripOffer {
  id             String          @id @default(cuid())
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId       String
  driver         DriverProfile   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  proposedFare   Decimal         @db.Decimal(12, 2)
  etaMinutes     Int
  status         TripOfferStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  respondedAt    DateTime?

  @@unique([tripId, driverId])
  @@index([tripId, status, createdAt])
}

model TripEvent {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id        String            @id @default(cuid())
  riderId   String
  rider     RiderProfile      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  kind      PaymentMethodKind
  brand     String?
  last4     String?
  isDefault Boolean           @default(false)
}

model LedgerEntry {
  id          String            @id @default(cuid())
  tripId      String?
  trip        Trip?             @relation(fields: [tripId], references: [id])
  userId      String
  type        LedgerType
  status      LedgerStatus
  method      PaymentMethodKind
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  brand       String?
  last4       String?
  providerRef String?
  note        String?
  createdAt   DateTime          @default(now())

  @@index([type, status, createdAt])
}

model FareConfig {
  id                String        @id @default(cuid())
  city              String
  zone              String?
  vehicleType       String
  customerSegment   String        @default("standard")
  baseFare          Decimal       @db.Decimal(10, 2)
  perKm             Decimal       @db.Decimal(10, 2)
  perMinute         Decimal       @db.Decimal(10, 2)
  minFare           Decimal       @db.Decimal(10, 2)
  bookingFee        Decimal       @db.Decimal(10, 2)
  airportFee        Decimal       @db.Decimal(10, 2)
  cancellationFee   Decimal       @db.Decimal(10, 2)
  waitingFee        Decimal       @db.Decimal(10, 2)
  surgeMultiplier   Decimal       @default(1) @db.Decimal(4, 2)
  status            PricingStatus @default(DRAFT)
  effectiveAt       DateTime
  createdById       String
  approvedById      String?
  previousId        String?
  createdAt         DateTime      @default(now())
}

model Zone {
  id      String   @id @default(cuid())
  name    String
  city    String
  kind    ZoneKind
  geojson Json
}

model SupportTicket {
  id          String         @id @default(cuid())
  subject     String
  category    String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  channel     String
  requesterId String
  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  riderId     String?
  rider       RiderProfile?  @relation(fields: [riderId], references: [id])
  tripId      String?
  trip        Trip?          @relation(fields: [tripId], references: [id])
  slaDueAt    DateTime?
  csatScore   Int?
  messages    TicketMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  internal  Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model SafetyIncident {
  id          String           @id @default(cuid())
  type        IncidentType
  severity    IncidentSeverity
  status      String           @default("OPEN")
  notes       String?
  evidenceUrl String?
  tripId      String?
  trip        Trip?            @relation(fields: [tripId], references: [id])
  riderId     String?
  rider       RiderProfile?    @relation("RiderIncidents", fields: [riderId], references: [id])
  driverId    String?
  driver      DriverProfile?   @relation("DriverIncidents", fields: [driverId], references: [id])
  assigneeId  String?
  assignee    User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  latitude    Float?
  longitude   Float?
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
}

model LostItem {
  id          String       @id @default(cuid())
  riderId     String
  rider       RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  tripId      String?
  description String
  status      String       @default("OPEN")
  createdAt   DateTime     @default(now())
}

model PrivacyRequest {
  id        String       @id @default(cuid())
  riderId   String
  rider     RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  kind      String
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
}

model Promo {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String
  percentOff    Decimal?  @db.Decimal(5, 2)
  amountOff     Decimal?  @db.Decimal(10, 2)
  city          String?
  vehicleType   String?
  riderGroup    String?
  firstRideOnly Boolean   @default(false)
  usageLimit    Int?
  usedCount     Int       @default(0)
  startsAt      DateTime
  expiresAt     DateTime
  active        Boolean   @default(true)
}

model DriverIncentive {
  id        String        @id @default(cuid())
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  kind      String
  amount    Decimal       @db.Decimal(10, 2)
  note      String?
  createdAt DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  channel   String
  template  String
  title     String
  body      String
  segment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model AdminLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Alert {
  id        String           @id @default(cuid())
  kind      AlertKind
  title     String
  body      String
  severity  IncidentSeverity
  city      String?
  entityId  String?
  resolved  Boolean          @default(false)
  createdAt DateTime         @default(now())
}
