# Eve Monolith - Optimized Single-Service Build

FROM node:20-alpine AS base
WORKDIR /app
ENV NODE_ENV=production

# Install dependencies
FROM base AS deps
COPY package*.json ./
COPY packages/*/package.json ./packages/
COPY src/package.json ./src/
RUN npm ci --only=production && npm cache clean --force

# Build application
FROM base AS builder
COPY package*.json ./
COPY tsconfig.json ./
COPY packages/ ./packages/
COPY src/ ./src/
RUN npm ci && npm run build:monolith

# Production image
FROM base AS runner
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 eve

COPY --from=deps --chown=eve:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=eve:nodejs /app/src/dist ./dist
COPY --from=builder --chown=eve:nodejs /app/packages ./packages

USER eve
EXPOSE 4000

ENV PORT=4000
ENV NODE_ENV=production

CMD ["node", "dist/server.js"]
